# Vacío = el navegador llama a /api/... del mismo origen y Next lo reenvía al
# backend (rewrites en next.config.ts). Necesario para exponer la app por un
# túnel. Para llamar directo al backend: NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
# Backend al que reenvía el proxy /api (solo lado servidor).
BACKEND_URL=http://localhost:3000
