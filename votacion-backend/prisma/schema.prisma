// ─────────────────────────────────────────────────────────────
//  Esquema Prisma — Sistema de Votacion Electronica FING (UNCuyo)
//  Fuente: B.2 BASE DE DATOS de la documentacion del sistema.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum EstadoEleccion {
  creada
  publicada
  finalizada
}

enum ResultadoTipo {
  ganador_unico
  empate
}

enum TipoEvento {
  login_exitoso
  login_fallido
  voto_emitido
  voto_error
  eleccion_creada
  eleccion_editada
  eleccion_eliminada
  lista_creada
  lista_editada
  lista_eliminada
  cierre_automatico
  apertura_automatica
  verificacion_integridad
  sesion_cerrada
}

enum RolUsuario {
  votante
  administrador
  sistema
}

// ─── ADMINISTRADOR ───────────────────────────────────────────
// Un unico registro (o pocos). Se carga directo en la BD.

model Administrador {
  id            Int    @id @default(autoincrement())
  correo        String @unique @db.VarChar(100)
  passwordHash  String @map("password_hash") @db.VarChar(255)

  @@map("administrador")
}

// ─── ELECCION ────────────────────────────────────────────────

model Eleccion {
  id              Int            @id @default(autoincrement())
  nombre          String         @db.VarChar(150)
  fechaInicio     DateTime       @map("fecha_inicio")
  fechaCierre     DateTime       @map("fecha_cierre")
  // Nullable: se llena con la address del contrato al desplegar (durante la creacion).
  contratoAddress String?        @map("contrato_address") @db.VarChar(42)
  estado          EstadoEleccion @default(creada)
  createdAt       DateTime       @default(now()) @map("created_at")

  // ─ Snapshot de resultados (solo elecciones finalizadas, ver modelo Resultado) ─
  // Nullable: se completan recien al tomar el snapshot al finalizar la eleccion.
  totalVotos      Int?           @map("total_votos")
  resultadoTipo   ResultadoTipo? @map("resultado_tipo")
  idListaGanadora Int?           @map("id_lista_ganadora")
  snapshotAt      DateTime?      @map("snapshot_at")
  // Tamanio del padron activo al momento del snapshot: sin esto, el % de
  // participacion de una eleccion finalizada quedaria recalculandose contra
  // el padron actual (que cambia con cada recarga semestral) en vez de
  // quedar fijo como el resto de los datos de una eleccion ya cerrada.
  totalPadron     Int?           @map("total_padron")

  listas          Lista[]
  participaciones Participacion[]
  resultados      Resultado[]

  @@map("eleccion")
}

// ─── LISTA ───────────────────────────────────────────────────

model Lista {
  id         Int     @id @default(autoincrement())
  idEleccion Int     @map("id_eleccion")
  nombre     String  @db.VarChar(100)
  esBlanco   Boolean @default(false) @map("es_blanco")
  // Posicion 0-based en el array _listas que se paso al constructor del contrato.
  // Critico para cruzar obtenerTodosLosVotos() con los registros de BD.
  indice     Int     @map("indice")
  // Color hex (#RRGGBB) para la visualizacion en el frontend. Nullable: el admin lo elige opcionalmente.
  color      String? @db.VarChar(7)

  // ON DELETE CASCADE: al borrar la eleccion se borran sus listas.
  eleccion Eleccion @relation(fields: [idEleccion], references: [id], onDelete: Cascade)

  resultados Resultado[]

  // Evita dos listas con el mismo nombre dentro de la misma eleccion.
  @@unique([idEleccion, nombre], name: "uq_lista_eleccion_nombre")
  // Evita indices duplicados dentro de la misma eleccion.
  @@unique([idEleccion, indice], name: "uq_lista_eleccion_indice")
  @@index([idEleccion])
  @@map("lista")
}

// ─── RESULTADO ───────────────────────────────────────────────
// Snapshot de los votos por lista, tomado del contrato en BFA al
// finalizar la eleccion (estrategia hibrida: ver README).

model Resultado {
  id         Int @id @default(autoincrement())
  idEleccion Int @map("id_eleccion")
  idLista    Int @map("id_lista")
  // Indice de la lista en el contrato (cruza con Lista.indice), copiado aca
  // para poder auditar el snapshot sin depender de que Lista no cambie.
  indice     Int
  votos      Int

  // ON DELETE CASCADE: al borrar la eleccion o la lista se borra su resultado.
  eleccion Eleccion @relation(fields: [idEleccion], references: [id], onDelete: Cascade)
  lista    Lista    @relation(fields: [idLista], references: [id], onDelete: Cascade)

  @@unique([idEleccion, idLista], name: "uq_resultado_eleccion_lista")
  @@index([idEleccion])
  @@map("resultado")
}

// ─── VOTANTE ─────────────────────────────────────────────────
// Se carga directo en la BD. La app no registra votantes.

model Votante {
  id             Int      @id @default(autoincrement())
  legajo         String   @unique @db.VarChar(20)
  nombreCompleto String   @map("nombre_completo") @db.VarChar(150)
  carrera        String   @db.VarChar(100)
  correo         String   @db.VarChar(100)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  participaciones Participacion[]

  @@map("votante")
}

// ─── PARTICIPACION ───────────────────────────────────────────
// Registra QUIEN voto en QUE eleccion y cuando. NUNCA a que lista.
// Intencionalmente NO tiene FK hacia LISTA (preserva el anonimato), y
// tampoco guarda nada que identifique la transaccion del voto en BFA: la
// transaccion lleva la lista en claro, asi que cualquier vinculo
// participacion -> transaccion revelaria el voto.
//
// Trigger trg_participacion_proteger_confirmada (migracion
// 20261007162536_participacion_confirmada_protegida, no lo modela Prisma):
// una participacion confirmada (hashPendiente = null) no se puede borrar ni
// modificar. Con hashes aleatorios el contrato no frena a la misma persona
// votando dos veces; lo frena esta fila, asi que no puede desaparecer.

model Participacion {
  id            Int      @id @default(autoincrement())
  idVotante     Int      @map("id_votante")
  idEleccion    Int      @map("id_eleccion")
  fechaVoto     DateTime @default(now()) @map("fecha_voto")
  // Hash aleatorio (bytes32) del voto mientras todavia no esta confirmado en
  // BFA. Se reutiliza si hay que reintentar (el contrato rechaza un hash
  // repetido, asi que un reintento nunca suma un segundo voto) y se borra
  // (null) al confirmarse. null = participacion confirmada.
  hashPendiente String?  @map("hash_pendiente") @db.VarChar(66)

  // ON DELETE RESTRICT: no se puede borrar un votante o eleccion con votos.
  votante  Votante  @relation(fields: [idVotante], references: [id], onDelete: Restrict)
  eleccion Eleccion @relation(fields: [idEleccion], references: [id], onDelete: Restrict)

  // Garantiza a nivel de BD que no haya voto duplicado por eleccion.
  @@unique([idVotante, idEleccion], name: "uq_participacion_votante_eleccion")
  @@index([idEleccion])
  @@map("participacion")
}

// ─── LOG ─────────────────────────────────────────────────────
// Eventos criticos. Nunca contiene passwords ni datos sensibles.

model Log {
  id          Int        @id @default(autoincrement())
  tipoEvento  TipoEvento @map("tipo_evento")
  descripcion String?    @db.Text
  // Nullable para eventos del sistema (cron, etc).
  idUsuario   Int?       @map("id_usuario")
  rolUsuario  RolUsuario @map("rol_usuario")
  timestamp   DateTime   @default(now())
  ip          String?    @db.VarChar(45)

  @@index([tipoEvento])
  @@index([timestamp])
  @@map("log")
}
